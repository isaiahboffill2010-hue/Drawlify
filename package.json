{
  "name": "drawlify",
  "version": "0.1.0",
  "private": true,
  "description": "Fullscreen touchscreen drawing app for Raspberry Pi built with Electron, Vite, and Fabric.js.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop:dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "fabric": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "electron": "43.2.0",
    "typescript": "^5.9.2",
    "vite": "5.4.21"
  }
}
